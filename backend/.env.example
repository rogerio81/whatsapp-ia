# Copie para .env e preencha antes de rodar.

APP_ENV=development

# Postgres
DATABASE_URL=postgresql+asyncpg://vendedor_ia:vendedor_ia@localhost:5432/vendedor_ia

# Redis (filas / arq)
REDIS_URL=redis://localhost:6379/0

# Claude API (https://console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Evolution API (gateway WhatsApp self-hosted)
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=
# Segredo compartilhado para validar que o webhook realmente veio do Evolution API
EVOLUTION_WEBHOOK_SECRET=troque-este-valor
